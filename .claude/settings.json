{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(dd *)",
      "Bash(shred *)",
      "Bash(mkfs *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(chown *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -df *)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr $HOME*)",
      "Bash(rm -rf .)",
      "Bash(rm -fr .)",
      "Bash(rm -rf ..)",
      "Bash(rm -fr ..)",
      "Bash(rm -rf ../*)",
      "Bash(rm -fr ../*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf .github*)",
      "Bash(rm -rf .claude*)",
      "Bash(rm -rf src*)",
      "Bash(rm -fr src*)",
      "Bash(rm -rf test*)",
      "Bash(rm -fr test*)",
      "Bash(rm -rf demos*)",
      "Bash(rm -fr demos*)",
      "Bash(rm -rf external*)",
      "Bash(rm -fr external*)",
      "Bash(rm -rf build/..)",
      "Bash(rm -rf build/../*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(conan upload *)",
      "Bash(conan remove *)",
      "Bash(pip install *)"
    ],
    "allow": [
      "Edit",
      "Write",
      "Bash(rm -rf build)",
      "Bash(rm -fr build)",
      "Bash(rm -rf build/)",
      "Bash(rm -fr build/)",
      "Bash(rm -rf ./build)",
      "Bash(rm -rf ./build/)",
      "Bash(rm -rf build/Release)",
      "Bash(rm -fr build/Release)",
      "Bash(rm -rf build/RelWithDebInfo)",
      "Bash(rm -fr build/RelWithDebInfo)",
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(clang++ *)",
      "Bash(clang-format *)",
      "Bash(clang-tidy *)",
      "Bash(cmake *)",
      "Bash(conan *)",
      "Bash(cp *)",
      "Bash(ctest *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(g++ *)",
      "Bash(gcov *)",
      "Bash(gdb *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(lcov *)",
      "Bash(ls *)",
      "Bash(make *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(ninja *)",
      "Bash(podman *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(tee *)",
      "Bash(touch *)",
      "Bash(uniq *)",
      "Bash(valgrind *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(xargs *)"
    ]
  }
}
